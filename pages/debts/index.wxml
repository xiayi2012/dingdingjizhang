<view class="page"><app-header title="欠款" subtitle="人情往来，记清不记心" back/><view class="totals"><view class="card"><text>待收</text><b>¥850</b></view><view class="card"><text>待还</text><b>¥300</b></view></view><view class="tabs"><text class="{{direction==='receivable'?'active':''}}" data-direction="receivable" bindtap="select">别人欠我的</text><text class="{{direction==='payable'?'active':''}}" data-direction="payable" bindtap="select">我欠别人的</text></view><empty-state wx:if="{{!debts.length}}" title="暂时没有欠款" description="新增一笔，约定日期更安心"/><view wx:for="{{debts}}" wx:key="id" class="debt card" data-id="{{item.id}}" bindtap="open"><view><text class="name">{{item.contact}}</text><text class="muted">约定 {{item.dueDate}}</text></view><view class="right"><status-tag text="{{item.status==='settled'?'已结清':'待处理'}}" tone="{{item.status==='settled'?'mint':'alert'}}"/><b>¥{{item.remainingCents/100}}</b></view></view></view>
