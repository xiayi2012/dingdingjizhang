<view class="page"><app-header title="{{loan.name}}" subtitle="贷款详情" back/><amount-card label="剩余本金" value="¥ {{loan.remainingCents/100}}" hint="每月应还 ¥{{loan.installmentCents/100}}"/><view class="facts card"><view><text>剩余期数</text><b>{{loan.totalPeriods-loan.paidPeriods}} 期</b></view><view><text>年利率</text><b>{{loan.rate}}%</b></view><view><text>下次还款</text><b>{{loan.nextPaymentDate}}</b></view></view><view class="history card"><text class="title">最近还款记录</text><view wx:if="{{!payments.length}}" class="muted">还没有登记过还款</view><view wx:for="{{payments}}" wx:key="id">{{item.date}} · ¥{{item.amountCents/100}}</view></view><button class="button-primary" bindtap="pay">登记本期还款</button></view>
