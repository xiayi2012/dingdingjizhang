<view class="page"><app-header title="贷款" subtitle="长期负担，也能清晰掌握" back/><amount-card label="剩余贷款" value="¥ {{total/100}}" hint="房贷与车贷合计"/><view wx:for="{{loans}}" wx:key="id" class="loan card" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="name">{{item.name}}</text><status-tag text="还款中" tone="cream"/></view><text class="amount">¥{{item.remainingCents/100}}</text><progress-bar value="{{item.paidPeriods/item.totalPeriods*100}}"/><view class="meta"><text>下次 {{item.nextPaymentDate}}</text><text>每期 ¥{{item.installmentCents/100}}</text></view></view></view>
