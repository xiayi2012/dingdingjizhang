.period{display:flex;background:#FFFDF8;border-radius:99rpx;padding:8rpx}.period text{flex:1;text-align:center;padding:16rpx}.period .active{background:#F1D37A;border-radius:99rpx;font-weight:700}.summary{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:24rpx 0}.balance,.chart{padding:28rpx;margin-bottom:20rpx}.balance text{font-size:38rpx;font-weight:800;margin:0 18rpx}.title{font-size:30rpx;font-weight:750}.bars{height:180rpx;display:flex;align-items:flex-end;gap:22rpx;margin-top:26rpx}.bar{flex:1;background:#7FAE9A;border-radius:12rpx 12rpx 4rpx 4rpx}.category{margin-top:24rpx}.line{display:flex;justify-content:space-between;margin-bottom:10rpx}
