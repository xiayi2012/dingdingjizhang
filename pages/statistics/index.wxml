<view class="page"><app-header title="统计" subtitle="看见每一笔生活的方向"/><view class="period"><text data-period="week" bindtap="select">本周</text><text class="{{period==='month'?'active':''}}" data-period="month" bindtap="select">本月</text><text data-period="year" bindtap="select">本年</text></view><view class="summary"><amount-card label="支出" value="¥ {{vm.expense}}" tone="cream"/><amount-card label="收入" value="¥ {{vm.income}}" tone="mint"/></view><view class="balance card">本期结余 <text>¥ {{vm.balance}}</text><status-tag text="较上月下降 8%" tone="mint"/></view><view class="chart card"><text class="title">支出趋势</text><view class="bars"><view wx:for="{{vm.trend}}" wx:key="date" class="bar" style="height:{{30+index*20}}rpx"></view></view></view><view class="chart card"><text class="title">分类排行</text><view wx:for="{{vm.categories}}" wx:key="name" class="category"><view class="line"><text>{{item.name}}</text><text>{{item.percent}}%</text></view><progress-bar value="{{item.percent}}"/></view></view></view>
