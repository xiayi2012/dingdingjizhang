<view class="page"><app-header title="明细" subtitle="7 月支出 ¥7,400 · 收入 ¥12,680"/><input class="search card" placeholder="搜索备注、分类或账户" bindinput="search"/>
<view class="filters"><text class="{{!type?'active':''}}" data-type="" bindtap="filter">全部</text><text class="{{type==='expense'?'active':''}}" data-type="expense" bindtap="filter">支出</text><text class="{{type==='income'?'active':''}}" data-type="income" bindtap="filter">收入</text></view>
<empty-state wx:if="{{!groups.length}}" title="还没有账目" description="记下第一笔，统计会自动生成" action="去记账"/>
<view wx:for="{{groups}}" wx:key="date" class="group"><view class="date">{{item.date}}</view><view wx:for="{{item.records}}" wx:for-item="record" wx:key="id" class="record card" data-id="{{record.id}}" bindlongpress="remove"><view><text>{{record.note||record.categoryName}}</text><text class="muted">{{record.categoryName}} · {{record.accountName}}</text></view><text class="{{record.type==='income'?'income':'expense'}}">{{record.type==='income'?'+':'-'}}¥{{record.amountCents/100}}</text></view></view></view>
