<view class="page"><app-header title="预算设置" subtitle="给每一笔消费留出边界" back/><view wx:for="{{budgets}}" wx:key="id" class="budget card"><view class="row"><text class="name">{{item.categoryName||'月总预算'}}</text><text>¥{{item.limitCents/100}}</text></view><progress-bar value="{{item.usage.percent}}" alert="{{item.usage.status!=='normal'}}"/><text class="muted">已用 {{item.usage.percent}}% · ¥{{item.usage.usedCents/100}}</text></view><view class="switches card"><label>达到 80% 时提醒<switch checked color="#7FAE9A"/></label><label>达到 100% 时提醒<switch checked color="#D9786C"/></label></view></view>
