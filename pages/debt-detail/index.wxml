<view class="page"><app-header title="{{debt.contact}}欠我" subtitle="欠款详情" back/><amount-card label="剩余待收" value="¥ {{debt.remainingCents/100}}" hint="约定日期 {{debt.dueDate}}" tone="mint"/><view class="overview card"><view><text>初始金额</text><b>¥{{debt.initialCents/100}}</b></view><view><text>已还金额</text><b>¥{{(debt.initialCents-debt.remainingCents)/100}}</b></view></view><view class="timeline card"><text class="title">分次还款记录</text><view wx:for="{{payments}}" wx:key="id"><text>{{item.date}}</text><b>+ ¥{{item.amountCents/100}}</b></view></view><button wx:if="{{debt.status!=='settled'}}" class="button-primary" bindtap="pay">登记剩余还款</button><status-tag wx:else text="已全部结清" tone="mint"/></view>
